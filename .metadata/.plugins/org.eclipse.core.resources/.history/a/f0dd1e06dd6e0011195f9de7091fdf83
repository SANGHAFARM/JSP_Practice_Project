<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	version="4.0">
	<display-name>servlet_db</display-name>

	<resource-ref>
		<description>Oracle Resource</description>
		<res-ref-name>jdbc/myconn</res-ref-name>
		<res-type>javax.sql.DataSource</res-type>
		<res-auth>Container</res-auth>
	</resource-ref>

	<servlet>
		<servlet-name>Round18_01_Servlet</servlet-name>
		<servlet-class>servlet_db.Round18_01_Servlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>Round18_01_Servlet</servlet-name>
		<url-pattern>/Servlet_18_01</url-pattern>
	</servlet-mapping>

	<filter>
		<filter-name>My_Ft_01</filter-name>
		<filter-class>servlet_db.Round18_01_Filter</filter-class>
	</filter>

	<filter-mapping>
		<filter-name>My_Ft_01</filter-name>
		<url-pattern>/Servlet_18_01</url-pattern>
	</filter-mapping>

	<servlet>
		<servlet-name>Round20_01</servlet-name>
		<jsp-file>/Round20_01_Page</jsp-file>
	
	</servlet>



	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
		<welcome-file>index.htm</welcome-file>
		<welcome-file>index.jsp</welcome-file>
		<welcome-file>default.html</welcome-file>
		<welcome-file>default.htm</welcome-file>
		<welcome-file>default.jsp</welcome-file>
	</welcome-file-list>
</web-app>